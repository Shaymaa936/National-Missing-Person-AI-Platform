{
  "name": "TraceAI — Missing Persons Platform",
  "short_name": "TraceAI",
  "description": "Report missing and found persons, send tips and help reunite families across Pakistan.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFFFF",
  "theme_color": "#0F172A",
  "lang": "en",
  "dir": "auto",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Report Missing", "url": "/report-missing", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Report Found", "url": "/report-found", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Missing Persons", "url": "/missing-persons", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
