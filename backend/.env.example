PORT=5000
MONGO_URL=
JWT_SECRET=
FACE_ENGINE_URL=http://localhost:8000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional: store uploaded photos outside the project (recommended on the VPS)
UPLOAD_DIR=
# Shared secret between backend and face engine (set the SAME value in face_dtc's environment)
FACE_ENGINE_SECRET=
# Comma-separated list of allowed frontend URLs, e.g. https://trace.pk (empty = allow all)
CORS_ORIGINS=
# NADRA CNIC verification (fill in once NADRA gives you access; until then CNICs stay "pending")
NADRA_API_URL=
NADRA_API_KEY=
# Email notifications to families (optional; leave empty to turn off)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Similarity (0-1) above which a new missing case is flagged as a possible duplicate
DUPLICATE_THRESHOLD=0.7
# Public website address, used in share links / previews (e.g. https://trace.pk; dev: http://localhost:5173)
PUBLIC_SITE_URL=
# Cloudflare Turnstile captcha secret key (free; empty = captcha off)
TURNSTILE_SECRET_KEY=
# Cloudinary: keeps a copy of every photo so it shows on every machine / the VPS.
# Use EITHER CLOUDINARY_URL (from the Cloudinary dashboard) OR the three values below.
# Empty = photos only on this machine's disk (old behaviour).
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder name inside Cloudinary (default: trace)
CLOUDINARY_FOLDER=trace
